# Copy to .env for LOCAL development only. Never use these demo values in production.
APP_ENV=local
HEALTHGUARD_PORT=8080
PUBLIC_URL=http://localhost:8080
TRUSTED_PROXIES=
TRUSTED_HOSTS=
DB_DATABASE=healthguard
DB_USERNAME=healthguard
DB_PASSWORD=local-development-password
DB_ROOT_PASSWORD=local-development-root-password
APP_KEY=
DEMO_SEED_ENABLED=false
SANCTUM_TOKEN_EXPIRATION=480
FEATURE_MESSAGES=true
FEATURE_PAYMENTS=true
FEATURE_EMAIL=false
FEATURE_REALTIME=false
CLAIM_SLA_HOURS=72
FEATURE_RETENTION=false
RETENTION_DAYS=0
MAIL_MAILER=array
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=healthguard@example.test
