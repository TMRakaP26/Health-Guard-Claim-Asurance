\n.app-shell {\r\n  display: grid;\r\n  grid-template-columns: 245px minmax(0, 1fr);\r\n  min-height: 100vh;\r\n}\r\n.sidebar {\r\n  min-width: 0;\r\n  background: #123e34;\r\n  color: #f4faf7;\r\n  padding: 2rem 1.3rem;\r\n}\r\n.sidebar nav {\r\n  display: grid;\r\n  gap: 0.3rem;\r\n  margin: 2rem 0;\r\n}\r\n.sidebar nav a {\r\n  padding: 0.65rem 0.8rem;\r\n  border-radius: 7px;\r\n  color: white;\r\n  text-decoration: none;\r\n}\r\n.sidebar nav a:hover {\r\n  background: #27574a;\r\n}\r\n.sidebar small {\r\n  color: #c1dbd1;\r\n}\r\n.mobile-menu-toggle {\r\n  display: none;\r\n}\r\n.mobile-navigation nav {\r\n  display: grid;\r\n  gap: 0.5rem;\r\n  margin-top: 1rem;\r\n}\r\n.mobile-navigation nav a {\r\n  padding: 0.65rem;\r\n}\r\n.main {\r\n  min-width: 0;\r\n  padding: 2.5rem;\r\n  max-width: 1500px;\r\n  width: 100%;\r\n  margin: 0 auto;\r\n}\r\n.topbar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 0.75rem;\r\n  flex-wrap: wrap;\r\n  margin-bottom: 1rem;\r\n}\r\n.locale-switch {\r\n  display: inline-flex;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  background: white;\r\n}\r\n.locale-switch button {\r\n  border: 0;\r\n  border-radius: 0;\r\n  min-height: 38px;\r\n  padding: 0.35rem 0.7rem;\r\n  background: transparent;\r\n}\r\n.locale-switch button + button {\r\n  border-left: 1px solid var(--border);\r\n}\r\n.locale-switch button.active {\r\n  background: var(--accent);\r\n  color: white;\r\n}\r\n.field small,\r\n.hint {\r\n  display: block;\r\n  color: #54685f;\r\n  font-size: 0.82rem;\r\n  margin-top: 0.35rem;\r\n}\r\n.pre-wrap {\r\n  white-space: pre-wrap;\r\n}\r\n.chat-log {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.8rem;\r\n  max-height: 460px;\r\n  overflow-y: auto;\r\n  padding: 0.75rem 0.25rem;\r\n  scroll-behavior: smooth;\r\n}\r\n.chat-message {\r\n  display: flex;\r\n  justify-content: flex-start;\r\n}\r\n.chat-message.mine {\r\n  justify-content: flex-end;\r\n}\r\n.chat-bubble {\r\n  max-width: min(78%, 620px);\r\n  background: #f2f6f4;\r\n  border: 1px solid var(--border);\r\n  border-radius: 14px 14px 14px 4px;\r\n  padding: 0.7rem 0.9rem;\r\n}\r\n.chat-message.mine .chat-bubble {\r\n  background: #e4f4ec;\r\n  border-color: #c8e5d7;\r\n  border-radius: 14px 14px 4px 14px;\r\n}\r\n.chat-bubble header {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: baseline;\r\n  gap: 0.45rem;\r\n  margin-bottom: 0.3rem;\r\n  font-size: 0.82rem;\r\n}\r\n.chat-bubble header time {\r\n  margin-left: auto;\r\n  color: #5d746b;\r\n  font-size: 0.75rem;\r\n}\r\n.chat-role {\r\n  border: 1px solid #c7ded2;\r\n  border-radius: 20px;\r\n  padding: 0 0.45rem;\r\n  font-size: 0.72rem;\r\n  color: #2f5e4e;\r\n}\r\n.chat-bubble p {\r\n  margin: 0.25rem 0;\r\n  white-space: pre-wrap;\r\n  overflow-wrap: anywhere;\r\n}\r\n.chat-bubble .actions {\r\n  margin: 0.35rem 0 0;\r\n}\r\n.chat-composer {\r\n  margin-top: 0.75rem;\r\n}\r\n.chat-composer textarea {\r\n  resize: vertical;\r\n}\r\n.page-header,\r\n.actions {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 0.75rem;\r\n  flex-wrap: wrap;\r\n}\r\n.actions {\r\n  justify-content: flex-start;\r\n  margin: 0.8rem 0;\r\n}\r\n.eyebrow {\r\n  letter-spacing: 0.15em;\r\n  color: #527468;\r\n  font-size: 0.75rem;\r\n  font-weight: bold;\r\n}\r\n.panel {\r\n  background: white;\r\n  border: 1px solid var(--border);\r\n  border-radius: 13px;\r\n  padding: 1.5rem;\r\n  margin: 1.3rem 0;\r\n  box-shadow: 0 4px 16px #143e3005;\r\n}\r\n.stats {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 1rem;\r\n}\r\n.stats article {\r\n  padding: 1.3rem;\r\n  background: white;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n}\r\n.stats span {\r\n  display: block;\r\n  color: #4d6660;\r\n}\r\n.stats strong {\r\n  font-size: clamp(1.15rem, 2vw, 1.8rem);\r\n  display: block;\r\n  margin-top: 0.