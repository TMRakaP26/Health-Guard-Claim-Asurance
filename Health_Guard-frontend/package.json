{
  "name": "healthguard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.17.0", "react": "18.3.1", "react-dom": "18.3.1",
    "react-router": "7.13.0", "lucide-react": "0.487.0", "sonner": "2.0.3",
    "xlsx": "^0.18.5", "clsx": "2.1.1", "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "vite": "6.3.5", "@vitejs/plugin-react": "4.7.0", "tailwindcss": "4.1.12",
    "@tailwindcss/vite": "4.1.12", "tw-animate-css": "1.3.8",
    "typescript": "~5.8.3", "@types/react": "^18.3.0", "@types/react-dom": "^18.3.0", "@types/node": "^22.0.0",
    "vitest": "^3.2.4", "jsdom": "^26.1.0", "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.3", "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.0", "@eslint/js": "^9.39.0", "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^5.2.0", "globals": "^16.4.0", "prettier": "^3.6.2",
    "@playwright/test": "^1.56.0", "@axe-core/playwright": "^4.11.0"
  }
}
