APP_NAME=HealthGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
# SQLite is convenient locally. Compose overrides this with MySQL 8.4.
DB_CONNECTION=sqlite
# DB_DATABASE=C:/absolute/path/to/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SANCTUM_TOKEN_EXPIRATION=480
DEMO_SEED_ENABLED=false
FEATURE_MESSAGES=true
FEATURE_PAYMENTS=true
FEATURE_EMAIL=false
FEATURE_REALTIME=false
FEATURE_RETENTION=false
RETENTION_DAYS=0
CLAIM_SLA_HOURS=72
TRUSTED_PROXIES=
TRUSTED_HOSTS=
MAIL_MAILER=array
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=healthguard@example.test
MAIL_FROM_NAME=HealthGuard
